NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
POSTGRES_PORT=55432
POSTGRES_DB=gove
POSTGRES_USER=gove
POSTGRES_PASSWORD=gove_local_only
DATABASE_URL=postgresql://gove:gove_local_only@127.0.0.1:55432/gove
AUTH_ACCESS_TTL_SECONDS=600
AUTH_ISSUER=gove-api
AUTH_AUDIENCE=gove-pwa
# Replace both values outside local development. Never commit real secret material.
AUTH_JWT_SECRET=gove-local-development-jwt-secret-change-before-production
AUTH_REFRESH_PEPPER=gove-local-development-refresh-pepper-change-before-production
AUTH_REFRESH_TTL_DAYS=14
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
# Optional local OSRM profile. Keep unset for the truthful coordinate fallback.
# Create/populate the external Docker volume outside this repository before use.
# OSRM_VOLUME_NAME=gove-osrm-data
# OSRM_DATASET=hanoi-latest
# OSRM_ALGORITHM=mld
# OSRM_PORT=5500
# ROUTING_OSRM_BASE_URL=http://127.0.0.1:5500/
# Optional deterministic local MapLibre preview style for browser acceptance.
# This is not a production basemap; use a reviewed style/provider in staging.
# VITE_MAPLIBRE_STYLE_URL=/assets/gove-map-preview.json
